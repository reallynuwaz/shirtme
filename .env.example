# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า:  cp .env.example .env
DOMAIN=shirtme.example.com
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
# สุ่มข้อความยาวๆ ได้ด้วยคำสั่ง: openssl rand -hex 32
SESSION_SECRET=

# ใช้เมื่อหน้าเว็บอยู่ Vercel และ backend อยู่ที่อื่น: ใส่โดเมน Vercel (คั่นด้วยคอมมา ไม่ต้องมี https://)
ALLOWED_ORIGINS=
